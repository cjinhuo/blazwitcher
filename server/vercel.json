{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"version": 2,
	"installCommand": "corepack enable && pnpm install --frozen-lockfile",
	"builds": [
		{
			"src": "src/main.ts",
			"use": "@vercel/node"
		}
	],
	"routes": [
		{
			"src": "/(.*)",
			"dest": "src/main.ts",
			"methods": ["GET", "POST", "PUT", "PATCH", "DELETE"]
		}
	]
}
